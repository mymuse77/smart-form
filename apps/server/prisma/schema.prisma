datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
}

model Capability {
  id            String              @id @default(uuid())
  tenantId      String
  name          String
  domain        String
  mode          String              @default("read")
  currentVersion String
  status        String              @default("DRAFT")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  versions      CapabilityVersion[]
}

model CapabilityVersion {
  id           String     @id @default(uuid())
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id])
  version      String
  checksum     String
  codeContent  String
  status       String     @default("VALIDATING")
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  action    String
  resource  String
  timestamp DateTime @default(now())
}
