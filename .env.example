# Shared development identity
TENANT_ID=local-tenant
WORKSPACE_ID=local-workspace
DEVICE_ID=local-device
DEVICE_ACCESS_TOKEN=smart-form-local-dev-token

# Control plane
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
AUTH_MODE=development
DEV_BEARER_TOKEN=smart-form-local-dev-token
RESOURCE_REPOSITORY=memory
CORS_ORIGINS=http://localhost:5173

# Production PostgreSQL (required when RESOURCE_REPOSITORY=prisma)
DATABASE_URL=postgresql://smart_form:change-me@127.0.0.1:5432/smart_form

# Artifact storage and signing
ARTIFACT_ROOT=data/artifacts
ARTIFACT_TRANSPORT=local
ARTIFACT_SIGNING_KEY_ID=local-ephemeral-key
# Production only: PKCS#8 Ed25519 private key encoded as base64
ARTIFACT_SIGNING_PRIVATE_KEY_B64=
ARTIFACT_PUBLIC_BASE_URL=

# Desktop outbound connection
SERVER_WS_URL=ws://127.0.0.1:3001/ws
# Production only: JSON map of key ID to SPKI DER base64 or PEM
ARTIFACT_SIGNING_PUBLIC_KEYS_JSON=

# Browser Use Sidecar (optional for read exploration)
BROWSER_USE_API_KEY=
BROWSER_USE_BASE_URL=
BROWSER_USE_MODEL=gpt-4.1-mini
# Production Desktop must point to a packaged, trusted executable.
SIDECAR_EXECUTABLE=
SIDECAR_WORKING_DIRECTORY=apps/browser-use-sidecar
SIDECAR_ARGS_JSON=["run","python","-m","smart_form_sidecar.worker"]

# Web/Vite development
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_WS_URL=ws://127.0.0.1:3001/ws
VITE_DEV_ACCESS_TOKEN=smart-form-local-dev-token
VITE_DEVICE_ID=local-device
VITE_WORKSPACE_ID=local-workspace
