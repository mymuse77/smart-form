{
  "name": "smart-form",
  "version": "0.1.0",
  "private": true,
  "description": "智能表单采集与填报通用系统",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:sites": "pnpm --filter @smart-form/test-sites dev",
    "dev:web": "pnpm --filter @smart-form/web dev",
    "dev:desktop": "pnpm --filter @smart-form/desktop dev",
    "dev:server": "pnpm --filter @smart-form/server dev",
    "db:generate": "pnpm --filter @smart-form/server run prisma:generate",
    "db:migrate:deploy": "pnpm --filter @smart-form/server run prisma:migrate",
    "db:push": "pnpm --filter @smart-form/server exec prisma db push --skip-generate --schema=prisma/schema.prisma",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:sidecar": "uv run --directory apps/browser-use-sidecar pytest -q",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "playwright": "^1.50.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
