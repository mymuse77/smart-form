{
  "name": "smart-form",
  "version": "0.1.0",
  "private": true,
  "description": "智能表单采集与填报通用系统",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:sites": "pnpm --filter @smart-form/test-sites dev",
    "dev:web": "pnpm --filter @smart-form/web dev",
    "dev:desktop": "pnpm --filter @smart-form/desktop dev",
    "dev:server": "pnpm --filter @smart-form/server dev",
    "db:push": "npx prisma@5 db push --skip-generate --schema=apps/server/prisma/schema.prisma",
    "lint": "eslint . --ext .ts,.vue",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
