# DeepSeek / OpenAI 兼容 LLM 配置
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端配置 (PostgreSQL 生产选型)
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_form?schema=public"

# 本地 Agent CDP 调试配置
CDP_PORT=9222

# 本地开发调试
LOG_LEVEL=debug
